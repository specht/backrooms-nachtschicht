# Flucht 1 von 5: Der Boden hinter dem Wartezimmer hängt zur Seite, und die
# Decke steigt nach hinten. Wer hier läuft, hält sich an der Wand fest.

[room]
name = Flucht 1
height = 2.8, 4.2
slope = east
ramp = south, 0.7
wallpaper = #b8c8b4
floor = carpet_tiles
carpet = #4d5d50
dado = 0.9, #3a2c22
dado_material = wood
cornice = 0.12, #ddd6c6

[map]
####################
#..................#
#..................2
1..L.....L.....L...2
1..................#
#..................#
####################

[L]
light = #ffe9c4
size = 1.2, 0.3
power = 1.6

[1]
door = wartezimmer 1
arch = 2.6
casing = on

[2]
door = flucht2 1
