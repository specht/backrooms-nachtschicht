# Flucht 3 von 5: Der Gang wird zur Halle. Ihr Boden hängt zur Seite, ihre
# Decke fällt von sieben Metern auf drei. Nichts darin ist waagerecht.

[room]
name = Flucht 3
height = 3, 7
slope = west
ramp = north, 2.5
wallpaper = #a59bb0
floor = carpet_tiles
carpet = #4a4256
dado = 0.9, #3a2c22
dado_material = wood
cornice = 0.12, #ddd6c6

