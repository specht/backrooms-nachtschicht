# Ein Notausgang, sagt das Schild nicht, denn es gibt keins. Der Gang steigt,
# und die Decke steigt schneller. Am Ende steht ein Schaukelstuhl, daneben brennt
# eine Leselampe.

[room]
name = Notgang
height = 2.4, 8
slope = east
ramp = east, 2
walls = plain
wallpaper = #b9b4a4
floor = concrete
carpet = #6f6c64
ceiling = #a8a395
baseboard = 0.1, #5c5850

[map]
##############################
1............................#
1..L.......L.......F.......SK#
##############################

[L]
light = #fff1d0
size = 0.6, 0.3
power = 0.9

[F]
light = #fff1d0
size = 0.6, 0.3
power = 0.9
flicker = 1

[K]
model = models/industrial_wall_sconce/industrial_wall_sconce_1k.gltf   # Poly Haven, CC0
height = 0.4
rotation = 180
offset = 0, 1.5, 0.35   # an der Südwand neben dem Schaukelstuhl, zum Lesen
light = #ffc07a
power = 0.3
beam = 75               # unter dem Schirm: nach unten

[S]
model = models/Rockingchair_01/Rockingchair_01_1k.gltf   # Poly Haven, CC0
height = 1.0
rotation = 270          # mit Blick den Gang hinunter
