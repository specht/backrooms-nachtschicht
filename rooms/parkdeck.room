# Ein Parkdeck unter dem Gebäude, niedrig und viel zu groß. Die Säulen stehen
# in Reihen, so weit man sieht. Nur ein paar Röhren brennen.

[room]
name = Parkdeck
height = 2.6
walls = concrete
wallpaper = #8a8984
floor = concrete
carpet = #63625e
ceiling = #75746f
baseboard = none

