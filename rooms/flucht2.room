# Flucht 2 von 5: breiter, und der Boden fällt wieder. Die Decke kippt jetzt
# zur anderen Seite.

[room]
name = Flucht 2
height = 2.6, 4.2
slope = south
ramp = west, 1.4
wallpaper = #a9b6c2
floor = carpet_tiles
carpet = #424e5c
dado = 0.9, #3a2c22
dado_material = wood
cornice = 0.12, #ddd6c6

[map]
################
#..............#
#..............#
1..L....L......#
1..............#
#..............2
#.....L....L...2
#..............#
################

[L]
light = #ffe9c4
size = 1.2, 0.3
power = 1.6

[1]
door = flucht1 2

[2]
door = flucht3 1
