# Ein Kino mit Sofas statt Sitzreihen. Die Leinwand ist weiß, der Film ist
# zu Ende oder hat noch nicht angefangen.

[room]
name = Kino
height = 5
walls = velvet
wallpaper = #5a1620
floor = carpet
carpet = #2a1418
ceiling = #1c1214
baseboard = none

[map]
######11#######
#QQQQ.........#
#QJQQ.........#
#.............#
#..S....S.....#
#A...........A#
#..S....S.....#
#.............#
#..S....S.....#
#.............#
#.............#
#......L......#
#......G......#
############22#

[Q]
raise = 1.2             # hinten: der Vorführraum ohne Wände
material = wood
color = #2b1c16
railing = on

[J]
model = nachtschicht/models/filmstrip_projector_8mm/filmstrip_projector_8mm_1k.gltf   # Poly Haven, CC0
height = 0.35
rotation = 160
on = Q

[S]
model = models/sofa_03/sofa_03_1k.gltf   # Poly Haven, CC0
height = 0.85
offset = 0.5, 0, 0

[G]
block = 6, 3, 0.05      # die Leinwand
base = 1
offset = 0, 0, 0.45
material = plain
color = #e6e6e0

[A]
light = #ff9a6a         # schwaches Licht an den Seiten, wie im Kino
size = 0.4
power = 0.5

[L]
light = #cfe0ff         # kaltes Licht auf die Leinwand
size = 5, 0.3
power = 1.8

[2]
door = diner 1
